#!/usr/bin/env bash
# fffind — minimal file search for agy-minimal.
# Thin deterministic wrapper over fd. Replaces `find_by_name`.
# Usage: fffind <pattern> [path] [-- <extra fd args>]
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: fffind <pattern> [path] [-- <fd args>]" >&2
  exit 2
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./lib-ffargs.sh disable=SC1091
. "$here/lib-ffargs.sh"
ff_parse_args "$@"

command -v fd >/dev/null 2>&1 || { echo "fffind: fd (fd-find) not found on PATH" >&2; exit 127; }

# shellcheck disable=SC2154  # `extra` assigned by sourced lib-ffargs.sh (ff_parse_args).
exec fd --color=never --hidden --exclude '.git' "${extra[@]}" -- "$pattern" "$path"
