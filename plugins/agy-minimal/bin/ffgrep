#!/usr/bin/env bash
# ffgrep — minimal text search for agy-minimal.
# Thin deterministic wrapper over ripgrep. Replaces `grep_search`.
# Usage: ffgrep <pattern> [path] [-- <extra rg args>]
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: ffgrep <pattern> [path] [-- <rg args>]" >&2
  exit 2
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./lib-ffargs.sh disable=SC1091
. "$here/lib-ffargs.sh"
ff_parse_args "$@"

command -v rg >/dev/null 2>&1 || { echo "ffgrep: rg (ripgrep) not found on PATH" >&2; exit 127; }

# shellcheck disable=SC2154  # `extra` assigned by sourced lib-ffargs.sh (ff_parse_args).
exec rg --no-heading --line-number --color=never --smart-case --hidden \
  --glob '!.git/*' --glob '!node_modules/*' --glob '!target/*' \
  "${extra[@]}" -- "$pattern" "$path"
